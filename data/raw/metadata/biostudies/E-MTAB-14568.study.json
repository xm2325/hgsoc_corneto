    "attributes" : [ {
      "name" : "Title",
      "value" : "RNA-seq of human ex vivo ovarian cancer models - part IV"
    }, {
      "name" : "Study type",
      "value" : "RNA-seq of coding RNA",
      "valqual" : [ {
